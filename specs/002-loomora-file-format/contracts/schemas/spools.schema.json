{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "loomora spools.json",
  "type": "object",
  "required": [
    "spools"
  ],
  "properties": {
    "spools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "color",
          "opacity",
          "diameter_mm"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "name": {
            "type": "string",
            "maxLength": 256
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "opacity": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "diameter_mm": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "available_length_mm": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "material": {
            "type": "string"
          },
          "domain": {
            "enum": [
              "exterior",
              "interior",
              "both"
            ]
          }
        }
      }
    }
  }
}
