{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "loomora image.json",
  "type": "object",
  "required": [
    "id",
    "name",
    "color_mode",
    "shape",
    "width_px",
    "height_px",
    "thumbnail"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "name": {
      "type": "string",
      "maxLength": 256
    },
    "color_mode": {
      "enum": [
        "bw",
        "gray",
        "color"
      ]
    },
    "shape": {
      "enum": [
        "circle",
        "landscape",
        "portrait",
        "square",
        "free"
      ]
    },
    "width_px": {
      "type": "integer",
      "minimum": 1
    },
    "height_px": {
      "type": "integer",
      "minimum": 1
    },
    "source": {
      "type": "object",
      "required": [
        "entry"
      ],
      "properties": {
        "entry": {
          "type": "string",
          "maxLength": 512
        },
        "format": {
          "enum": [
            "png",
            "jpeg",
            "webp"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "target": {
      "type": "object",
      "required": [
        "entry"
      ],
      "properties": {
        "entry": {
          "type": "string",
          "maxLength": 512
        },
        "format": {
          "enum": [
            "png",
            "jpeg",
            "webp"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "thumbnail": {
      "type": "object",
      "required": [
        "entry"
      ],
      "properties": {
        "entry": {
          "type": "string",
          "maxLength": 512
        },
        "format": {
          "enum": [
            "png",
            "jpeg",
            "webp"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
